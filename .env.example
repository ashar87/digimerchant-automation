# ============================================================
#  MODEL — which one reads your chats
# ============================================================
# gemini | anthropic
LLM_PROVIDER=gemini

# --- Gemini (recommended: your Google AI Pro plan includes $10/mo of Cloud credits) ---
# IMPORTANT: enable Cloud Billing on this key. On the FREE tier Google may use your
# content to improve its products and human reviewers may see it — these are your
# supplier prices, margins and VAT conversations. Paid tier excludes training.
GEMINI_API_KEY=
# Run `npm run models` to see what's live on your key, then set a Flash-tier model here.
GEMINI_MODEL=gemini-3.8-flash
# Used ONLY when a conversation carries a screenshot or PDF. Dense Seller Central
# tables are where a Flash tier is most likely to misread a figure, and those
# conversations are rare — so pointing this at a Pro-tier model costs very little.
# Leave blank to use GEMINI_MODEL for everything.
GEMINI_VISION_MODEL=

# --- Anthropic (only needed if LLM_PROVIDER=anthropic, or for `npm run replay -- --both`) ---
# NOTE: not included in Claude Pro. Separate prepaid credits at console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ============================================================
#  MEDIA
# ============================================================
# OFF for now — task capture doesn't need screenshots, and leaving it off means
# images are never downloaded or sent anywhere. The code path is intact: flip to
# true when the receipt → landing-cost work starts (see ROADMAP.md).
ENABLE_IMAGES=false
ENABLE_VOICE_NOTES=true
# OFF for now, same as images — PDFs and spreadsheets are never downloaded or sent.
# Code path intact; flip to true for the receipt → landing-cost work (see ROADMAP.md).
ENABLE_DOCUMENTS=false

# How voice notes become text:
#   gemini        send the audio to Gemini (handles Urdu / Roman Urdu / code-switching)
#   whisper-local whisper.cpp on this Mac — nothing leaves the machine
#   none          ignore voice notes entirely
TRANSCRIBER=gemini
# Which model does the transcribing (defaults to GEMINI_MODEL)
TRANSCRIBE_MODEL=

# Only for TRANSCRIBER=whisper-local:
#   brew install whisper-cpp ffmpeg
#   curl -L -o ~/ggml-large-v3.bin https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-large-v3.bin
WHISPER_CLI=whisper-cli
WHISPER_MODEL_PATH=
# 'auto', or force a language: ur = Urdu, en = English
WHISPER_LANGUAGE=auto

# How much detail the model gets on images. HIGH is right for reading small numbers
# off Seller Central / Sellerboard screenshots. LOW | MEDIUM | HIGH | ULTRA_HIGH
IMAGE_RESOLUTION=HIGH

# WhatsApp voice notes are OGG/Opus; Google documents OGG *Vorbis*. If a native
# attempt is rejected, re-encode with ffmpeg (brew install ffmpeg) and retry once.
AUDIO_FFMPEG_FALLBACK=true

# Attachments larger than this are skipped
MAX_ATTACHMENT_MB=8

# ============================================================
#  NOTION — no longer written to. Approved WhatsApp tasks now go on the
#  dashboard's task board (Tasks tab). Kept only for `npm run setup:notion`.
# ============================================================
NOTION_API_KEY=
# Filled in for you by `npm run setup:notion`
NOTION_DATABASE_ID=
# Only needed once, for setup:notion. Share a Notion page with your integration first.
NOTION_PARENT_PAGE_ID=

# ============================================================
#  BEHAVIOUR
# ============================================================
# Seconds of silence in a chat before the conversation is sent to the model.
FLUSH_IDLE_SECONDS=90
# Force a flush once this many messages pile up, even if people are still typing.
FLUSH_MAX_MESSAGES=25
# Candidates below this confidence are dropped silently (never bother you).
MIN_CONFIDENCE=0.55
# Log what WOULD happen without sending WhatsApp messages or writing to Notion.
DRY_RUN=false
# On startup, also process messages from the last N minutes while the bot was down.
CATCH_UP_MINUTES=0
# If WhatsApp never becomes ready within this many seconds, exit so the service
# manager restarts. Without it a broken startup sits alive but deaf.
READY_TIMEOUT_SECONDS=90
# Pending task cards older than this are quietly expired so the queue can't rot.
EXPIRE_PENDING_DAYS=7

# ============================================================
#  LANDING COSTS
# ============================================================
# Where the landing-cost records live (default data/landing.db)
LANDING_DB_PATH=
# The dashboard's address as you open it (e.g. the Tailscale https link); WhatsApp
# replies link approved tasks there. Leave blank for no link.
DASHBOARD_URL=
# Pin WhatsApp Web to an older build when a new one breaks whatsapp-web.js (the
# start log says "stuck page ... store:false"). Put the page at data/wa-web/<version>.html
# (from github.com/wppconnect-team/wa-version, checked to load only WhatsApp's own files).
WA_WEB_VERSION=
# Its expiry date from the archive's versions.json (yyyy-mm-dd); the Inbox warns two weeks before.
WA_WEB_VERSION_EXPIRES=
# Dashboard port (it only ever listens on 127.0.0.1) and who may edit
DASHBOARD_PORT=3210
DASHBOARD_USERS=Ashar,Atif

# --- Amazon Selling Partner API: shipment status and received counts ---
# From Solution Provider Portal → your app → LWA credentials. Leave blank and the
# Amazon sync stays off. Never paste these into a chat: put them on the server with
# the command in DEPLOY.md.
SPAPI_LWA_CLIENT_ID=
SPAPI_LWA_CLIENT_SECRET=
# Self-authorise the app once per region; each gives a refresh token.
SPAPI_REFRESH_TOKEN_EU=
SPAPI_REFRESH_TOKEN_NA=

# --- Sellerboard cost feed (a Google Sheet Sellerboard's COGS import reads daily) ---
# Path to the Google service account's JSON key, the sheet's ID (from its URL), and the tab.
# Share the sheet with the service account's email as Editor. Keep the sheet's link private:
# anyone with it can see your unit costs.
GOOGLE_SERVICE_ACCOUNT_FILE=
SELLERBOARD_SHEET_ID=
SELLERBOARD_SHEET_TAB=COGS

# --- Nightly backup of data/landing.db, encrypted with this passphrase ---
# Keep a copy of the passphrase somewhere other than this server, or the backups are useless.
BACKUP_PASSPHRASE=
BACKUP_DIR=
BACKUP_KEEP=30

# --- Wise: read your transfers so payments don't have to be typed (optional) ---
# A personal API token with read access (Wise → Settings → API tokens). Wise restricts
# personal tokens for UK/EEA accounts; check it can list transfers.
WISE_API_TOKEN=
WISE_PROFILE_ID=

# --- QuickBooks Online: the QB exchange rate for each payment date (optional) ---
# From an app at developer.intuit.com (scope com.intuit.quickbooks.accounting). The refresh
# token rotates on every use; after the first run the newest one is kept in data/landing.db.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=
QBO_REFRESH_TOKEN=
QBO_ENVIRONMENT=production
