{
  "name": "digimerchant-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WhatsApp -> Claude task extraction -> approval -> Notion task board, for Digi Merchant FBA ops.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "chats": "node scripts/list-chats.js",
    "setup:notion": "node scripts/setup-notion.js",
    "replay": "node scripts/replay.js",
    "models": "node scripts/models.js",
    "verify": "node scripts/verify-chats.js",
    "dry": "DRY_RUN=true DEBUG=1 node src/index.js",
    "reset:queue": "node scripts/reset-queue.js",
    "diagnose:media": "node scripts/diagnose-media.js",
    "report": "node scripts/report.js",
    "test": "node --test 'test/**/*.test.js'",
    "landing:check": "node scripts/landing-check.js",
    "dashboard": "node src/dashboard/server.js",
    "landing:import": "node scripts/landing-import.js",
    "amazon:sync": "node scripts/amazon-sync.js",
    "sellerboard:feed": "node scripts/sellerboard-feed.js",
    "landing:backup": "node scripts/landing-backup.js",
    "wise:import": "node scripts/wise-import.js",
    "qb:rates": "node scripts/qb-rates.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "@google/genai": "^2.18.0",
    "@notionhq/client": "^2.3.0",
    "better-sqlite3": "^12.10.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.1"
  }
}
