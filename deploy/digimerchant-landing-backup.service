# /etc/systemd/system/digimerchant-landing-backup.service — run by the timer below.
[Unit]
Description=Digi Merchant: encrypted backup of the landing-cost database

[Service]
Type=oneshot
User=digimerchant
WorkingDirectory=/opt/digimerchant
ExecStart=/usr/bin/node scripts/landing-backup.js
StandardOutput=journal
StandardError=journal
SyslogIdentifier=digimerchant-landing-backup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/digimerchant/data
