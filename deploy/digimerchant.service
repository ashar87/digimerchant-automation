# /etc/systemd/system/digimerchant.service
[Unit]
Description=Digi Merchant WhatsApp task capture
After=network-online.target
Wants=network-online.target
# These belong in [Unit], not [Service] — systemd ignores them with a warning otherwise.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=digimerchant
WorkingDirectory=/opt/digimerchant
ExecStart=/usr/bin/node src/index.js

# Dates shown to the model must be the business's, not the server's.
Environment=TZ=Europe/London
Environment=NODE_ENV=production
Environment=PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# The app deliberately exits when WhatsApp disconnects, so restarting IS the
# reconnect strategy. StartLimit stops a genuinely broken build from looping.
Restart=always
RestartSec=15

# SIGINT so it flushes buffered conversations and closes Chromium cleanly —
# a killed Chromium leaves a profile lock that costs you a fresh QR scan.
KillSignal=SIGINT
TimeoutStopSec=45
# The app exits 130 on SIGINT after flushing, which is a clean stop, not a failure.
SuccessExitStatus=130 SIGINT

StandardOutput=journal
StandardError=journal
SyslogIdentifier=digimerchant

# Chromium needs to write; everything else stays read-only.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/digimerchant/data

[Install]
WantedBy=multi-user.target
